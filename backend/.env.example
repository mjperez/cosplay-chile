# Copiar a .env y completar. .env está en .gitignore.

ENVIRONMENT=local
DEBUG=true

# PostgreSQL. En Supabase, el panel entrega la cadena en
# Project Settings > Database > Connection string.
# Acepta postgresql:// y postgres://; el validador agrega el driver psycopg.
# Ejemplo con el pooler de Supabase (sesión, puerto 5432):
#   postgresql://postgres.<ref>:<clave>@aws-0-us-east-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cosplay_chile

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# Mínimo 16 caracteres. Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambia-esta-clave-por-una-aleatoria
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Costo de bcrypt. 12 en producción; las pruebas usan 4.
BCRYPT_ROUNDS=12

# Lista de orígenes. Acepta JSON o valores separados por comas.
CORS_ORIGINS=http://localhost:5173
