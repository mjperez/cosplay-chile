# Copiar a backend/.env y ajustar. Nunca subir el .env real al repositorio.

# Conexión async a PostgreSQL (en el informe se despliega en Neon; aquí local)
DATABASE_URL=postgresql+asyncpg://cosplay:cosplay@localhost:5432/cosplay
# Base usada por pytest (se borra y recrea en cada corrida)
TEST_DATABASE_URL=postgresql+asyncpg://cosplay:cosplay@localhost:5432/cosplay_test

# Firma de los JWT: genera una propia con  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRA_MINUTOS=60

# URL pública del frontend (para el enlace de recuperación de contraseña y CORS)
FRONTEND_URL=http://localhost:5173

# Almacenamiento de archivos (Adapter): local | cloudinary
STORAGE_BACKEND=local
MEDIA_DIR=media
MAX_UPLOAD_MB=5
# Solo si STORAGE_BACKEND=cloudinary
CLOUDINARY_URL=

# Correo de moderación (simulado con log en el prototipo)
CORREO_MODERACION=moderacion@cosplaychile.cl
